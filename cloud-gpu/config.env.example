# RunPod cloud GPU spoke — provisioning configuration
# Copy to config.env and fill in values. Never commit config.env.

# ── Pod identity ──────────────────────────────────────────────────────────────
# Set after first create-pod.sh run. Leave blank for initial provisioning.
RUNPOD_POD_ID=

# ── RunPod API ────────────────────────────────────────────────────────────────
# API key: set via environment or RunPod CLI config. Never put the key here.
# RUNPOD_API_KEY is read from the environment at runtime.

# ── Model configuration ──────────────────────────────────────────────────────
RUNPOD_MODEL_REPO=huihui-ai/Qwen3-Coder-30B-A3B-abliterated
RUNPOD_MODEL_QUANTIZATION=fp8
RUNPOD_MODEL_MAX_LENGTH=65536
RUNPOD_VLLM_EXTRA_ARGS=--enable-reasoning --reasoning-parser deepseek_r1

# ── GPU selection ─────────────────────────────────────────────────────────────
RUNPOD_GPU_TYPE=NVIDIA RTX A6000
RUNPOD_GPU_COUNT=1
RUNPOD_VOLUME_SIZE_GB=100

# ── Template / image ─────────────────────────────────────────────────────────
# Community vLLM template — check RunPod template library for current ID.
RUNPOD_TEMPLATE_ID=
RUNPOD_DOCKER_IMAGE=runpod/worker-vllm:stable-cuda12.1.0

# ── Networking ────────────────────────────────────────────────────────────────
RUNPOD_EXPOSE_PORTS=8000/http

# ── Idle management ───────────────────────────────────────────────────────────
# Auto-stop Pod after this many seconds of idle (0 = never).
RUNPOD_IDLE_TIMEOUT=1800

# ── Cost budget (USD) ────────────────────────────────────────────────────────
RUNPOD_BUDGET_MONTHLY_USD=125
RUNPOD_BUDGET_WARN_PCT=80
RUNPOD_BUDGET_BLOCK_PCT=95

# ── Health check ──────────────────────────────────────────────────────────────
RUNPOD_HEALTH_PROBE_TIMEOUT=30
RUNPOD_HEALTH_TEST_PROMPT=Reply with the single word: ready
RUNPOD_HEALTH_MAX_LATENCY_MS=10000
